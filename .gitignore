# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
/.quarto/

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds

# ==============================================================================
# Research Data (land misallocation paper)
# ==============================================================================

# Raw geodata — never commit (too large, proprietary)
geodata/
Data/raw/
*.tif
*.tiff
*.img
*.hdf
*.nc

# Shapefiles — gitignored by default; commit processed ones intentionally
*.shp
*.shx
*.dbf
*.prj
*.sbx
*.sbn
*.cpg

# Large Stata datasets — commit small processed ones explicitly
*.dta

# Python artifacts
.ipynb_checkpoints/
*.egg-info/
