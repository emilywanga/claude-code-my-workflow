@unpublished{FismanWangYe2025_StrategicCaptureOfMonitors,
  title        = {Strategic Capture of Monitors: Evidence from Pollution Control in {China}},
  author       = {Fisman, Raymond and Wang, Yongxiang and Ye, Naide},
  year         = {2025},
  note         = {Working paper, October 1, 2025},
  url          = {https://sites.bu.edu/fisman/files/2025/10/Strategic_capture.pdf},
  abstract     = {Third-party monitors are commonly deployed to mitigate agency problems in multi-layered organizations. Yet these third-party relationships may themselves be subject to agency concerns, and monitors co-opted by the entities they oversee. We examine how third-party monitoring can be undermined by collusion between monitor and agent, in the context of pollution monitoring in China. We exploit an outsourcing reform that transferred the operation and maintenance (O\&M) of pollution monitoring stations from local governments to third-party firms selected by the central government. We find that local governments significantly increased procurement transactions with their assigned O\&M firms post-reform. Additionally, following these transactions, reported air pollution from monitoring stations declined, as did enforcement actions against nearby polluting firms. Our results suggest that oversight was undermined by collusive arrangements of monitors and agents.},
  keywords     = {Principal-Agent Problems; Delegated Monitoring; Local Capture; Information Disclosure; Political Economy}
}

